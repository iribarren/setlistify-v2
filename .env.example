# Root compose-level environment. Copy to `.env` (gitignored) — Docker Compose reads that file
# automatically for variable substitution in compose.yaml.
#
# This is NOT the backend's environment: application config lives in `backend/.env.local`
# (see `backend/.env.example` and `docs/env-vars.md`). Only values compose itself substitutes
# belong here.

# The uid/gid the backend and worker containers run as. They must match YOUR host user, because
# ./backend is bind-mounted into both containers: anything the container writes there (Composer
# installs, cache, generated migrations, files an agent or the framework creates) is owned by this
# uid on the host too.
#
# Leave them unset and the image defaults to 1000. If your host uid is not 1000, every
# container-written file lands owned by a different user, and you get "Permission denied" on
# ordinary operations — editing those files, and `git stash`/`git checkout` failing partway through
# a branch switch because git cannot unlink them.
#
# Set these to your own ids:
#     printf 'APP_UID=%s\nAPP_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
#
# After changing them: docker compose build backend worker && docker compose up -d
APP_UID=1000
APP_GID=1000

# Number of `messenger:consume` replicas for playlist generation (compose.yaml `worker`).
PLAYLIST_WORKER_COUNT=2

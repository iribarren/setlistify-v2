<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <!--
        D-5 (docs/specs/2026-08-21-backend-skeleton.md): no .env or .env.test is committed.
        APP_ENV is forced to "test" here; DATABASE_URL, REDIS_URL, APP_SECRET and
        CORS_ALLOW_ORIGIN come from the real process environment (the same one `docker compose
        exec backend ...` already provides — see backend/.env.example). Doctrine's own
        `when@test: dbal: dbname_suffix: '_test'` (config/packages/doctrine.yaml) is what points
        the test run at a separate `<dbname>_test` database on the same PostgreSQL instance
        (AC-7.5) — nothing here needs to duplicate that.
    -->
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <!--
            Both <env> and <server> are set: the container's real APP_ENV (dev) is already
            present in $_ENV from the process environment, and Symfony's KernelTestCase reads
            $_ENV before $_SERVER — a <server>-only override would silently lose to it.
        -->
        <env name="APP_ENV" value="test" force="true" />
        <server name="APP_ENV" value="test" force="true" />
        <env name="KERNEL_CLASS" value="App\Kernel" force="true" />
        <server name="KERNEL_CLASS" value="App\Kernel" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>
</phpunit>

<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <!--
        D-5 (docs/specs/2026-08-21-backend-skeleton.md): no .env or .env.test is committed.
        APP_ENV is forced to "test" here; DATABASE_URL, REDIS_URL, APP_SECRET and
        CORS_ALLOW_ORIGIN come from the real process environment (the same one `docker compose
        exec backend ...` already provides — see backend/.env.example). Doctrine's own
        `when@test: dbal: dbname_suffix: '_test'` (config/packages/doctrine.yaml) is what points
        the test run at a separate `<dbname>_test` database on the same PostgreSQL instance
        (AC-7.5) — nothing here needs to duplicate that.
    -->
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <!--
            Both <env> and <server> are set: the container's real APP_ENV (dev) is already
            present in $_ENV from the process environment, and Symfony's KernelTestCase reads
            $_ENV before $_SERVER — a <server>-only override would silently lose to it.
        -->
        <env name="APP_ENV" value="test" force="true" />
        <server name="APP_ENV" value="test" force="true" />
        <env name="KERNEL_CLASS" value="App\Kernel" force="true" />
        <server name="KERNEL_CLASS" value="App\Kernel" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />

        <!-- ###+ lexik/jwt-authentication-bundle ### -->
        <env name="JWT_SECRET_KEY" value="%kernel.project_dir%/config/jwt/private.pem"/>
        <env name="JWT_PUBLIC_KEY" value="%kernel.project_dir%/config/jwt/public.pem"/>
        <env name="JWT_PASSPHRASE" value="c17356e19b0a6e2df73650ec4a31fbfa8fd27732192d7997c919f3389fd0fff9"/>
        <!-- ###- lexik/jwt-authentication-bundle ### -->

        <!-- ###+ symfony/lock ### -->
        <!-- Choose one of the stores below -->
        <!-- postgresql+advisory://db_user:db_password@localhost/db_name -->
        <env name="LOCK_DSN" value="flock"/>
        <!-- ###- symfony/lock ### -->

        <!-- ###+ symfony/mailer ### -->
        <!-- force="true": backend/.env.local sets a real (dev) MAILER_DSN, and compose injects it
             into this container's real process env — without force, that would win over this
             value, and AC-12.2's mailer-assertion tests would try a real SMTP connection. -->
        <env name="MAILER_DSN" value="null://null" force="true"/>
        <!-- ###- symfony/mailer ### -->

        <!-- ###+ symfony/messenger ### -->
        <!-- Choose one of the transports below -->
        <!-- MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages -->
        <!-- MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages -->
        <env name="MESSENGER_TRANSPORT_DSN" value="doctrine://default?auto_setup=0"/>
        <!-- ###- symfony/messenger ### -->

        <!-- Auth and accounts (docs/specs/2026-08-21-auth-and-accounts.md). force="true" for the
             same reason as MAILER_DSN above — these must not depend on whatever's in .env.local. -->
        <env name="JWT_TTL" value="900" force="true"/>
        <env name="REFRESH_TOKEN_TTL" value="2592000" force="true"/>
        <env name="EMAIL_VERIFICATION_TOKEN_TTL" value="86400" force="true"/>
        <env name="PASSWORD_RESET_TOKEN_TTL" value="3600" force="true"/>
        <env name="AUTH_REQUIRE_VERIFIED_EMAIL" value="false" force="true"/>
        <env name="AUTH_COOKIE_SECURE" value="false" force="true"/>
        <env name="MAILER_FROM_ADDRESS" value="no-reply@setlistify.test" force="true"/>
        <env name="WEB_APP_URL" value="http://localhost:8081" force="true"/>

        <!-- Backoffice foundation (docs/specs/2026-08-21-backoffice-foundation.md) — force="true"
             for the same reason as the auth block above: tests must not depend on .env.local. -->
        <env name="ADMIN_PATH_PREFIX" value="/admin" force="true"/>
        <env name="ADMIN_TOTP_ISSUER" value="Setlistify" force="true"/>
        <env name="ADMIN_IP_ALLOWLIST" value="" force="true"/>
        <env name="ADMIN_TOTP_ENCRYPTION_KEY" value="qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqo=" force="true"/>

        <!-- setlist.fm integration (docs/specs/2026-08-22-setlistfm-integration.md) — force="true"
             for the same reason as the blocks above: the default test suite must never depend on
             .env.local, and AC-13.1/D-2 require it to make zero outbound calls regardless. The key
             below is deliberately NOT real-looking (SetlistFmApiKeyNotRealTest, AC-13.2). Every
             test in the default suite mocks HttpClientInterface, so SETLISTFM_BASE_URL is never
             actually dialled. -->
        <env name="SETLISTFM_API_KEY" value="test-fixture-key-not-a-real-credential" force="true"/>
        <env name="SETLISTFM_DAILY_BUDGET" value="1440" force="true"/>
        <env name="SETLISTFM_RATE_PER_SECOND" value="2" force="true"/>
        <env name="SETLISTFM_CACHE_TTL" value="300" force="true"/>
        <env name="SETLISTFM_BASE_URL" value="https://setlistfm.invalid/rest/1.0" force="true"/>
        <env name="SETLISTFM_HTTP_TIMEOUT" value="5" force="true"/>
        <env name="SETLISTFM_TOKEN_WAIT" value="1" force="true"/>
        <env name="SETLISTFM_REFRESH_BUDGET_SHARE" value="0.25" force="true"/>

        <!-- Streaming port and account linking (docs/specs/2026-08-22-streaming-port-and-account-linking.md)
             — force="true" for the same reason as every block above: the default suite must never
             depend on .env.local, and D-2/AC-12.1 require zero network calls to a real provider
             regardless. Every test in the default suite mocks HttpClientInterface or uses the
             test-double adapter, so SPOTIFY_API_BASE_URL/SPOTIFY_ACCOUNTS_BASE_URL are never
             actually dialled. The key/secret below are deliberately not real-looking. -->
        <env name="SPOTIFY_CLIENT_ID" value="test-fixture-client-id" force="true"/>
        <env name="SPOTIFY_CLIENT_SECRET" value="test-fixture-client-secret-not-a-real-credential" force="true"/>
        <env name="SPOTIFY_REDIRECT_URI" value="https://backend.test/api/streaming/spotify/callback" force="true"/>
        <env name="SPOTIFY_API_BASE_URL" value="https://spotify-api.invalid/v1" force="true"/>
        <env name="SPOTIFY_ACCOUNTS_BASE_URL" value="https://spotify-accounts.invalid" force="true"/>
        <env name="TOKEN_ENCRYPTION_KEY" value="qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqo=" force="true"/>
        <env name="TOKEN_ENCRYPTION_KEY_ID" value="v1" force="true"/>
        <env name="TOKEN_ENCRYPTION_KEYS_RETIRED" value="" force="true"/>
        <env name="STREAMING_HTTP_TIMEOUT" value="5" force="true"/>
        <env name="STREAMING_TOKEN_REFRESH_SKEW" value="60" force="true"/>
        <env name="STREAMING_LINK_STATE_TTL" value="600" force="true"/>
        <env name="STREAMING_LINK_RETURN_URL_WEB" value="https://web.test/account" force="true"/>
        <env name="STREAMING_LINK_RETURN_URL_NATIVE" value="setlistify://account" force="true"/>

        <!-- Backoffice provider configuration (docs/specs/2026-08-22-backoffice-provider-configuration.md). -->
        <env name="PROVIDER_SETTINGS_CACHE_TTL" value="300" force="true"/>
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <!-- AC-13.3, D-70: the one live setlist.fm smoke test is tagged #[Group('live')] and excluded
         from the default suite (and therefore from CI, D-2). Run it manually before a release
         (see the root README.md's Operations section for the exact command) with a real
         SETLISTFM_API_KEY set. -->
    <groups>
        <exclude>
            <group>live</group>
        </exclude>
    </groups>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>
</phpunit>

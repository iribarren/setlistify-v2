# Setlistify backend — environment variable contract.
#
# This is the ONLY environment file that is ever committed (docs/env-vars.md, "Rule zero").
# Copy it to .env.local for local development:
#
#   cp backend/.env.example backend/.env.local
#
# Every value below is a placeholder — obviously fake, never a working credential.
# Variables marked [SECRET] must come from a secret store in every real environment
# (CI: repository secrets; production: the PaaS secret store — never a committed .env file).
# See docs/env-vars.md for the full boundary rules and the per-variable table this file mirrors.

###############################################################################
# Core
###############################################################################

APP_ENV=dev
APP_SECRET=changeme-generate-a-random-32-byte-secret # [SECRET]
DATABASE_URL=postgresql://setlistify:changeme@postgres:5432/setlistify?serverVersion=17&charset=utf8 # [SECRET]
REDIS_URL=redis://redis:6379 # [SECRET]
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages # [SECRET]
CORS_ALLOW_ORIGIN=^https?://localhost(:[0-9]+)?$

###############################################################################
# Authentication
###############################################################################

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem # [SECRET]
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem # [SECRET]
JWT_PASSPHRASE=changeme-jwt-passphrase # [SECRET]
JWT_TTL=900
REFRESH_TOKEN_TTL=2592000
TOKEN_ENCRYPTION_KEY=replace-me-with-a-32-byte-base64-libsodium-key # [SECRET]
# Streaming port and account linking (docs/specs/2026-08-22-streaming-port-and-account-linking.md,
# D-78): the key id stamped into every NEW ciphertext, and the retired keys still valid for
# decryption only. Rotation: add the retiring key here as "id:base64key", then set a new active
# TOKEN_ENCRYPTION_KEY/_KEY_ID pair — no downtime, no migration.
TOKEN_ENCRYPTION_KEY_ID=v1
# [SECRET] e.g. "v1:base64keyA,v2:base64keyB". Left quoted-empty rather than bare "KEY=" — Docker
# Compose's env_file parser only strips a trailing "# comment" when a real value precedes it; on a
# blank value it takes the comment text itself as the value (see docs/env-vars.md).
TOKEN_ENCRYPTION_KEYS_RETIRED=""

# Single-use token lifetimes (docs/specs/2026-08-21-auth-and-accounts.md AC-6.2, AC-7.1), seconds.
EMAIL_VERIFICATION_TOKEN_TTL=86400
PASSWORD_RESET_TOKEN_TTL=3600

# D-19: verification is built but not enforced by default. Flip to `true` to require a verified
# email at login (AC-7.4/AC-7.5) — a config change, no code change.
AUTH_REQUIRE_VERIFIED_EMAIL=false

# D-18: the refresh-token cookie's `Secure` flag. `true` in every real deployment (HTTPS only).
# Browsers treat `localhost` as a secure context, so `true` also works for local dev over http;
# only set `false` if your local setup genuinely can't use it.
AUTH_COOKIE_SECURE=true

# Symfony Mailer DSN only — no provider SDK in application code (D-20). Mailpit in dev (compose.yaml).
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM_ADDRESS=no-reply@setlistify.app

# Base URL of the web app — used to build the links inside verification/reset emails (AC-6.8).
WEB_APP_URL=http://localhost:8081

###############################################################################
# setlist.fm
###############################################################################

SETLISTFM_API_KEY=replace-me-with-a-setlistfm-api-key # [SECRET]
SETLISTFM_DAILY_BUDGET=1440
SETLISTFM_RATE_PER_SECOND=2
SETLISTFM_CACHE_TTL=300
# Raising SETLISTFM_DAILY_BUDGET above 1440 is valid ONLY after setlist.fm grants a higher tier
# (docs/external-apis.md, D-69) — it is an env change, never a code change, but doing it without
# the grant will get the key rate-limited by setlist.fm itself.
SETLISTFM_BASE_URL=https://api.setlist.fm/rest/1.0
SETLISTFM_HTTP_TIMEOUT=5
SETLISTFM_TOKEN_WAIT=1
SETLISTFM_REFRESH_BUDGET_SHARE=0.25

# Instant setlist refresh (docs/specs/2026-08-27-instant-setlist-refresh.md, D-254, D-259) — the
# single entitled exception to the nightly-only freshness policy above. Spends from the SAME
# 1,440/day pool; no separate quota.
SETLISTFM_REFRESH_NOW_COOLDOWN=3600
SETLISTFM_REFRESH_NOW_DAILY_PER_USER=5
SETLISTFM_REFRESH_NOW_BUDGET_RESERVE=0.10
SETLISTFM_REFRESH_NOW_TOKEN_WAIT=3

###############################################################################
# Streaming providers — credentials only; enabled/playbackMode/isDefault are
# backoffice flags (ProviderSetting), not environment variables.
###############################################################################

SPOTIFY_CLIENT_ID=replace-me-with-a-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-me-with-a-spotify-client-secret # [SECRET]
# Use the literal loopback IP, not "localhost" — Spotify's authorization server rejects
# "localhost" redirect URIs and returns "redirect_uri: Not matching configuration".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/streaming/spotify/callback
# Point fixtures / the @group live smoke test elsewhere without a code change (docs/specs/
# 2026-08-22-streaming-port-and-account-linking.md, AC-9.6). Confined to config/packages/streaming.yaml.
SPOTIFY_API_BASE_URL=https://api.spotify.com/v1/
SPOTIFY_ACCOUNTS_BASE_URL=https://accounts.spotify.com

# Provider-agnostic streaming settings (docs/specs/2026-08-22-streaming-port-and-account-linking.md).
STREAMING_HTTP_TIMEOUT=5
STREAMING_TOKEN_REFRESH_SKEW=60
STREAMING_LINK_STATE_TTL=600
STREAMING_LINK_RETURN_URL_WEB=http://localhost:8081/account
STREAMING_LINK_RETURN_URL_NATIVE=setlistify://account

YOUTUBE_CLIENT_ID=replace-me-with-a-youtube-client-id
YOUTUBE_CLIENT_SECRET=replace-me-with-a-youtube-client-secret # [SECRET]
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/streaming/youtube/callback
YOUTUBE_DAILY_QUOTA_UNITS=10000

###############################################################################
# Backoffice provider configuration (docs/specs/2026-08-22-backoffice-provider-configuration.md).
# Backstop TTL only — correctness comes from explicit invalidation on every admin write (D-92).
###############################################################################

PROVIDER_SETTINGS_CACHE_TTL=300

# Apple MusicKit — future (docs/architecture.md §4)
APPLE_TEAM_ID=replace-me-with-an-apple-team-id
APPLE_KEY_ID=replace-me-with-an-apple-key-id
APPLE_PRIVATE_KEY=replace-me-with-an-apple-musickit-es256-private-key # [SECRET]

###############################################################################
# Playlist generation (docs/specs/2026-08-23-spike-playlist-pipeline.md,
# docs/specs/2026-08-23-playlist-fast-mode-backend.md)
###############################################################################

# Number of `messenger:consume async_playlist` worker replicas (compose.yaml).
PLAYLIST_WORKER_COUNT=2

# P-1, accepted 2026-08-23: caps on one generation, cutting from the lowest-billed end.
GENERATION_MAX_BANDS=4
GENERATION_MAX_SONGS=60

# D-131: at most this many setlist.fm index pages spent per band per generation — never a
# per-setlist detail fetch, never a speculative freshness check.
GENERATION_SETLIST_PAGES=1

# P-4, accepted 2026-08-23: how long a suspended job survives before `app:playlist:expire-jobs`
# moves it to `expired`. Fast mode never suspends, so these have no runtime effect in this feature.
SUSPENDED_SETLIST_CHOICE_TTL=604800
SUSPENDED_VERSION_CHOICE_TTL=259200

# spec 13 §4/§5: provider insert batch size, and the two idempotency/block-recovery bounds.
GENERATION_INSERT_BATCH_SIZE=50
GENERATION_MAX_BLOCK_CYCLES=3
GENERATION_RATE_LIMIT_INLINE_RETRIES=3

###############################################################################
# Backoffice
###############################################################################

ADMIN_PATH_PREFIX=/admin
ADMIN_TOTP_ISSUER=Setlistify
ADMIN_IP_ALLOWLIST=
ADMIN_TOTP_ENCRYPTION_KEY=replace-me-with-a-base64-32-byte-key # [SECRET]

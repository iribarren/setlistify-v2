# Setlistify backend — environment variable contract.
#
# This is the ONLY environment file that is ever committed (docs/env-vars.md, "Rule zero").
# Copy it to .env.local for local development:
#
#   cp backend/.env.example backend/.env.local
#
# Every value below is a placeholder — obviously fake, never a working credential.
# Variables marked [SECRET] must come from a secret store in every real environment
# (CI: repository secrets; production: the PaaS secret store — never a committed .env file).
# See docs/env-vars.md for the full boundary rules and the per-variable table this file mirrors.

###############################################################################
# Core
###############################################################################

APP_ENV=dev
APP_SECRET=changeme-generate-a-random-32-byte-secret # [SECRET]
DATABASE_URL=postgresql://setlistify:changeme@postgres:5432/setlistify?serverVersion=17&charset=utf8 # [SECRET]
REDIS_URL=redis://redis:6379 # [SECRET]
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages # [SECRET]
CORS_ALLOW_ORIGIN=^https?://localhost(:[0-9]+)?$

###############################################################################
# Authentication
###############################################################################

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem # [SECRET]
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem # [SECRET]
JWT_PASSPHRASE=changeme-jwt-passphrase # [SECRET]
JWT_TTL=3600
REFRESH_TOKEN_TTL=2592000
TOKEN_ENCRYPTION_KEY=replace-me-with-a-32-byte-base64-libsodium-key # [SECRET]

###############################################################################
# setlist.fm
###############################################################################

SETLISTFM_API_KEY=replace-me-with-a-setlistfm-api-key # [SECRET]
SETLISTFM_DAILY_BUDGET=1440
SETLISTFM_RATE_PER_SECOND=2
SETLISTFM_CACHE_TTL=300

###############################################################################
# Streaming providers — credentials only; enabled/playbackMode/isDefault are
# backoffice flags (ProviderSetting), not environment variables.
###############################################################################

SPOTIFY_CLIENT_ID=replace-me-with-a-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-me-with-a-spotify-client-secret # [SECRET]
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/streaming/spotify/callback

YOUTUBE_CLIENT_ID=replace-me-with-a-youtube-client-id
YOUTUBE_CLIENT_SECRET=replace-me-with-a-youtube-client-secret # [SECRET]
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/streaming/youtube/callback
YOUTUBE_DAILY_QUOTA_UNITS=10000

# Apple MusicKit — future (docs/architecture.md §4)
APPLE_TEAM_ID=replace-me-with-an-apple-team-id
APPLE_KEY_ID=replace-me-with-an-apple-key-id
APPLE_PRIVATE_KEY=replace-me-with-an-apple-musickit-es256-private-key # [SECRET]

###############################################################################
# Backoffice
###############################################################################

ADMIN_PATH_PREFIX=/admin
ADMIN_TOTP_ISSUER=Setlistify
ADMIN_IP_ALLOWLIST=

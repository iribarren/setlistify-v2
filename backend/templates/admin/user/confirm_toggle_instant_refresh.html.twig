{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ entitled ? 'Revoke' : 'Grant' }} instant setlist refresh{% endblock %}

{% block main %}
    {% if error is defined and error %}
        <p style="color:#b00020;">{{ error }}</p>
    {% endif %}

    <p>User <strong>{{ masked_email }}</strong> (id {{ user.id }}) is currently
        <strong>{{ entitled ? 'entitled' : 'not entitled' }}</strong> to on-demand setlist refresh.</p>

    {% if entitled %}
        <p>Revoking takes effect immediately: the next trigger from this user is refused. Anything
            already in flight is not cancelled.</p>
    {% else %}
        <p>Granting lets this user force a live re-check of a stuck band's setlist.fm identity, and —
            when that comes back ambiguous — pick which same-named band is theirs. That pick writes a
            shared identity every user of that band inherits, correctable afterwards only by an
            operator's MBID correction.</p>
    {% endif %}

    <form method="post" action="{{ action_path }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_action') }}">
        <button type="submit">{{ entitled ? 'Revoke instant refresh' : 'Grant instant refresh' }}</button>
        <a href="{{ detail_path }}">Cancel</a>
    </form>
{% endblock %}

{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ user.active ? 'Suspend' : 'Unsuspend' }} user{% endblock %}

{% block main %}
    {% if error is defined and error %}
        <p style="color:#b00020;">{{ error }}</p>
    {% endif %}

    <p>User <strong>{{ masked_email }}</strong> (id {{ user.id }}) is currently
        <strong>{{ user.active ? 'active' : 'suspended' }}</strong>.</p>

    {% if user.active %}
        <p>Suspending also revokes every refresh token this user holds — any already-issued session
            will stop working immediately.</p>
    {% endif %}

    <form method="post" action="{{ action_path }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_action') }}">
        <button type="submit">{{ user.active ? 'Suspend this user' : 'Unsuspend this user' }}</button>
        <a href="{{ detail_path }}">Cancel</a>
    </form>
{% endblock %}

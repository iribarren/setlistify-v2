{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Dashboard{% endblock %}

{% block main %}
    <div style="display:flex; gap:2em; margin-bottom:2em;">
        <div>
            <div style="font-size:2em;">{{ total_users }}</div>
            <div>Total users</div>
        </div>
        <div>
            <div style="font-size:2em;">{{ total_concerts }}</div>
            <div>Total concerts</div>
        </div>
        <div>
            <div style="font-size:2em;">{{ recent_concerts }}</div>
            <div>Concerts created in the last 7 days</div>
        </div>
    </div>

    <h3>setlist.fm (US-11)</h3>
    <div style="display:flex; gap:2em; margin-bottom:1em;">
        <div>
            <div style="font-size:2em;">{{ setlistfm_used }} / {{ setlistfm_budget }}</div>
            <div>Requests used today ({{ setlistfm_percent }}%)</div>
        </div>
        <div>
            <div style="font-size:2em;">{{ setlistfm_reset_at|date('Y-m-d H:i') }} UTC</div>
            <div>Budget resets at</div>
        </div>
        <div>
            <div style="font-size:2em; {{ setlistfm_breaker_state == 'open' ? 'color:#b00020;' : '' }}">{{ setlistfm_breaker_state }}</div>
            <div>Circuit breaker</div>
        </div>
    </div>

    <div style="display:flex; gap:2em; margin-bottom:1em;">
        <div>
            <div style="font-size:1.5em;">{{ (setlistfm_today.hitRate * 100)|round(1) }}%</div>
            <div>Cache hit rate — today (Redis {{ setlistfm_today.redis }}, PG {{ setlistfm_today.postgres }}, outbound {{ setlistfm_today.outbound }})</div>
        </div>
        <div>
            <div style="font-size:1.5em;">{{ (setlistfm_trailing7.hitRate * 100)|round(1) }}%</div>
            <div>Cache hit rate — trailing 7 days (Redis {{ setlistfm_trailing7.redis }}, PG {{ setlistfm_trailing7.postgres }}, outbound {{ setlistfm_trailing7.outbound }})</div>
        </div>
        <div>
            <div style="font-size:1.5em;">{{ setlistfm_total_cache_entries }}</div>
            <div>Total durable cache entries</div>
        </div>
        <div>
            <div style="font-size:1.5em;">{{ setlistfm_total_songs }}</div>
            <div>Total stored songs</div>
        </div>
    </div>

    <div style="{{ setlistfm_last_run_stale ? 'color:#b00020;' : '' }}">
        {% if setlistfm_last_run is null %}
            <strong>Nightly refresh has never run.</strong>
        {% else %}
            <strong>Last nightly refresh:</strong> {{ setlistfm_last_run.finishedAt }} —
            {{ setlistfm_last_run.bandsAttempted }} band(s) attempted,
            {{ setlistfm_last_run.requestsSpent }} request(s) spent,
            {{ setlistfm_last_run.entriesWritten }} setlist(s) written,
            {{ setlistfm_last_run.budgetRemaining }} of its share remaining.
            {% if setlistfm_last_run_stale %}<strong> — over 36 hours old (R-9)</strong>{% endif %}
        {% endif %}
    </div>

    <h3>Playlist generation (last 7 days)</h3>
    <div style="display:flex; gap:2em; margin-bottom:1em;">
        <div>
            <div style="font-size:1.5em;">{{ playlist_metrics.jobsStarted }}</div>
            <div>Jobs started</div>
        </div>
        <div>
            <div style="font-size:1.5em;">{{ playlist_metrics.jobsCompleted }}</div>
            <div>Jobs completed</div>
        </div>
        <div>
            <div style="font-size:1.5em;">{{ playlist_metrics.jobsBlocked }}</div>
            <div>Jobs blocked</div>
        </div>
        <div>
            <div style="font-size:1.5em;">{{ playlist_metrics.jobsFailed }}</div>
            <div>Jobs failed</div>
        </div>
    </div>

    <div style="display:flex; gap:2em; margin-bottom:1em;">
        <div>
            <div style="font-size:1.5em; {{ playlist_metrics.investigate.p95Duration ? 'color:#b00020;' : '' }}">
                {{ playlist_metrics.p95DurationMs is null ? '—' : (playlist_metrics.p95DurationMs / 1000)|round(1) ~ 's' }}
            </div>
            <div>p95 generation time (investigate above 90s)</div>
        </div>
        <div>
            <div style="font-size:1.5em;">
                {{ playlist_metrics.p50DurationMs is null ? '—' : (playlist_metrics.p50DurationMs / 1000)|round(1) ~ 's' }}
            </div>
            <div>p50 generation time</div>
        </div>
        <div>
            <div style="font-size:1.5em; {{ playlist_metrics.investigate.matchRate ? 'color:#b00020;' : '' }}">
                {{ playlist_metrics.meanMatchRate is null ? '—' : (playlist_metrics.meanMatchRate * 100)|round(1) ~ '%' }}
            </div>
            <div>Mean match rate (investigate below 75%)</div>
        </div>
        <div>
            <div style="font-size:1.5em;">
                {{ playlist_metrics.notFoundRate is null ? '—' : (playlist_metrics.notFoundRate * 100)|round(1) ~ '%' }}
            </div>
            <div>Not-found rate</div>
        </div>
        <div>
            <div style="font-size:1.5em; {{ playlist_metrics.investigate.blockedShare ? 'color:#b00020;' : '' }}">
                {{ playlist_metrics.jobsStarted > 0 ? ((playlist_metrics.jobsBlocked / playlist_metrics.jobsStarted) * 100)|round(1) ~ '%' : '—' }}
            </div>
            <div>Blocked share (investigate above 10%)</div>
        </div>
    </div>

    <div style="margin-bottom:1em;">
        <strong>Blocked reason breakdown:</strong>
        {% if playlist_metrics.blockedReasonBreakdown is empty %}
            none
        {% else %}
            {% for reason, count in playlist_metrics.blockedReasonBreakdown %}
                {{ reason }}: {{ count }}{{ loop.last ? '' : ', ' }}
            {% endfor %}
        {% endif %}
    </div>

    <div>
        <strong>Top 5 unmatched (artist, title) pairs:</strong>
        {% if playlist_metrics.topUnmatchedPairs is empty %}
            <div>none</div>
        {% else %}
            <ol>
                {% for pair in playlist_metrics.topUnmatchedPairs %}
                    <li>{{ pair.artist }} — {{ pair.title }} ({{ pair.count }})</li>
                {% endfor %}
            </ol>
        {% endif %}
    </div>
{% endblock %}

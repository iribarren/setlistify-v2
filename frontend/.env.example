# Setlistify frontend (Expo) — environment variable contract.
#
# Copy to .env.local for local development:
#
#   cp frontend/.env.example frontend/.env.local
#
# IMPORTANT: anything prefixed EXPO_PUBLIC_ is inlined into the JS bundle at build time and
# ships inside the app on every platform (web, iOS, Android). It is PUBLIC. Never put a secret
# behind an EXPO_PUBLIC_ variable — see docs/env-vars.md, "Frontend (Expo)".
#
# Provider availability and playback mode are NOT frontend variables: the client reads them at
# startup from GET /api/config/providers, so a backoffice change reaches users with no app-store
# release.

# Backend base URL. Points at the containerized backend stack (see compose.yaml / README.md).
# On a physical device, replace localhost with your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Environment label for logging/telemetry only — not a secret.
EXPO_PUBLIC_ENV=development

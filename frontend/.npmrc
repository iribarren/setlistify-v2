# openapi-typescript (devDependency, AC-6.1) declares a peer on typescript@^5.x; this project runs
# the SDK-tested TypeScript version Expo installs (currently 6.x). openapi-typescript does not
# actually import the project's typescript package at runtime — it bundles its own — so the peer
# conflict is cosmetic. legacy-peer-deps keeps `npm ci`/`npm install` from failing on it, here and
# in CI.
legacy-peer-deps=true
